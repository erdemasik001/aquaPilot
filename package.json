{
  "name": "aquapilot",
  "version": "0.0.0",
  "private": true,
  "description": "The first strategy composer for the 1inch SwapVM instruction set: validated, multi-leg SwapVM programs executed against Aqua on a mainnet fork.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "husky",
    "typecheck": "node scripts/workspaces-run.mjs typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "node scripts/workspaces-run.mjs build",
    "test": "node scripts/workspaces-run.mjs test",
    "verify": "node scripts/verify.mjs",
    "setup:repo": "node scripts/setup-repo.mjs",
    "setup:branch-protection": "node scripts/setup-branch-protection.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
